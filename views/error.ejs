<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/output.css">
    <title><%= error %> | HN</title>
  </head>
  <body class="bg-hn-bg dark:bg-hn-bg-dark font-verdana text-black text-xs dark:text-hn-text-dark">
    <main class="max-w-4xl mx-auto p-4">
      <div class="font-bold mb-4 text-lg">
        <a class="no-underline text-hn-orange" href="/">HN</a>
      </div>

      <div class="border-b border-gray-300 dark:border-hn-border-dark mb-6 pb-3">
        <h1 class="font-normal mb-2 text-sm"><%= error %></h1>
        <p class="text-gray-500 text-xs"><%= message %></p>
      </div>

      <p class="text-gray-500 text-xs">
        <a class="text-hn-orange underline" href="/">← Back to homepage</a>
      </p>
    </main>
  </body>
</html>
