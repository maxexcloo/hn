<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/output.css">
    <script defer src="/comments.js"></script>
    <title><%= story.title %> | HN</title>
  </head>
  <body class="bg-hn-bg dark:bg-hn-bg-dark font-verdana text-black text-xs dark:text-hn-text-dark">
    <main class="max-w-4xl mx-auto p-4">
      <div class="font-bold mb-4 text-lg">
        <a class="no-underline text-hn-orange" href="/">HN</a>
      </div>

      <header class="border-b border-gray-300 dark:border-hn-border-dark mb-6 pb-3">
        <h1 class="font-normal mb-2 text-sm"><%= story.title %></h1>
        <div class="text-gray-500 text-xs">
          <%= story.score %> points by <%= story.by %> |
          <%= story.descendants || 0 %> comments
          <% if (storyUrl) { %>
            | <a class="text-gray-500 underline" href="<%= storyUrl %>" rel="nofollow noreferrer">link</a>
          <% } %>
        </div>
      </header>

      <% if (comments.length === 0) { %>
        <p class="italic text-gray-500 text-xs">No comments yet.</p>
      <% } else { %>
        <%- include('partials/comment', { comments, level: 0 }) %>
      <% } %>
    </main>
  </body>
</html>
