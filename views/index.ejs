<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/output.css">
    <script defer src="/stories.js"></script>
    <title>HN</title>
  </head>
  <body class="bg-hn-bg dark:bg-hn-bg-dark font-verdana text-black text-xs dark:text-hn-text-dark">
    <main class="max-w-4xl mx-auto p-4">
      <h1 class="font-bold mb-4 text-hn-orange text-lg">HN</h1>

      <div aria-label="Story filters" class="mb-4 text-xs" id="filters">
        <button class="filter-btn mr-2 no-underline px-2 py-1 rounded" data-filter="top-10" type="button">Top 10</button>
        <button class="filter-btn mr-2 no-underline px-2 py-1 rounded" data-filter="top-20" type="button">Top 20</button>
        <button class="filter-btn mr-2 no-underline px-2 py-1 rounded" data-filter="top-50" type="button">Top 50%</button>
        <button class="filter-btn mr-2 no-underline px-2 py-1 rounded" data-filter="all" type="button">All</button>
      </div>

      <div id="stories-container"></div>
      <p class="mt-8 text-center text-gray-500" id="loading">Loading stories…</p>
    </main>

    <script id="bootstrap-data" type="application/json"><%- bootstrapData %></script>
  </body>
</html>
